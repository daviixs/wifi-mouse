---
/** A real app screenshot shown as a cropped "screen panel" inside feature cards. */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** CSS object-position, e.g. "50% 80%". */
  focus?: string;
  class?: string;
  sizes?: string;
}
const { src, alt, focus = '50% 0%', class: className = '', sizes = '(min-width: 1024px) 560px, 92vw' } = Astro.props;
---

<div class:list={['screen-panel', className]} style={`--focus:${focus}`}>
  <Picture
    src={src}
    alt={alt}
    widths={[360, 560, 780]}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    quality={76}
    loading="lazy"
    decoding="async"
  />
</div>
