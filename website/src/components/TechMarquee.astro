---
import Icon from './Icon.astro';

const items = [
  { name: 'Rust', icon: 'RustLogo', brand: 'rust', size: 22 },
  { name: 'React Native', icon: 'ReactLogo', brand: 'react', size: 22 },
  { name: 'Expo', icon: 'ExpoLogo', brand: 'expo', size: 20 },
  { name: 'TypeScript', icon: 'TypeScriptLogo', brand: 'typescript', size: 36, badge: true },
  { name: 'SwiftUI', icon: 'SwiftLogo', brand: 'swift', size: 36, badge: true },
  { name: 'WebSocket', icon: 'WebSocketLogo', brand: 'websocket', size: 30 },
  { name: 'mDNS', icon: 'MdnsLogo', brand: 'mdns', size: 34, badge: true },
  { name: 'Win32', icon: 'WindowsLogo', brand: 'windows', size: 20 },
];
---

<section class="marquee-section" aria-labelledby="marquee-title">
  <div class="container">
    <p id="marquee-title" class="marquee-title reveal">Built On Open, Proven Technology</p>
    <div class="marquee" data-marquee>
      <ul class="marquee-track">
        {
          [...items, ...items].map((item, i) => (
            <li aria-hidden={i >= items.length ? 'true' : undefined}>
              <span class:list={['marquee-icon', `marquee-icon--${item.brand}`, { 'marquee-icon--badge': item.badge }]}>
                <Icon name={item.icon} size={item.size} />
              </span>
              {item.name}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
