---
/**
 * Hand-built CSS smartphone frame around a real app screenshot.
 * The screenshot keeps its native 390×844 (iPhone-class) aspect ratio.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  /** CSS `sizes` hint for the responsive image. */
  sizes?: string;
  eager?: boolean;
  /** Fade the lower part of the device into the page, as in the reference hero. */
  fade?: boolean;
}

const { src, alt, class: className = '', sizes = '(min-width: 1024px) 300px, 70vw', eager = false, fade = false } = Astro.props;
---

<figure class:list={['phone', className, { 'phone-fade': fade }]}>
  <div class="phone-body">
    <span class="phone-btn phone-btn-action" aria-hidden="true"></span>
    <span class="phone-btn phone-btn-vol1" aria-hidden="true"></span>
    <span class="phone-btn phone-btn-vol2" aria-hidden="true"></span>
    <span class="phone-btn phone-btn-power" aria-hidden="true"></span>
    <div class="phone-screen">
      <span class="phone-status" aria-hidden="true">
        <span>9:41</span>
        <span class="phone-status-icons"><i class="ps-signal"></i><i class="ps-battery"></i></span>
      </span>
      <Picture
        src={src}
        alt={alt}
        widths={[300, 450, 600, 780]}
        sizes={sizes}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        quality={78}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding="async"
      />
      <span class="phone-island" aria-hidden="true"></span>
    </div>
  </div>
</figure>
