{
  "expo": {
    "name": "Remote Mouse",
    "slug": "wifi-mouse",
    "description": "Use o celular como touchpad para computadores na mesma rede Wi-Fi.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wifimouse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.davixavier.remotemouse",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "O Remote Mouse encontra e controla computadores na mesma rede Wi-Fi."
      }
    },
    "android": {
      "package": "com.davixavier.remotemouse",
      "adaptiveIcon": {
        "backgroundColor": "#101211",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101211",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 144
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
